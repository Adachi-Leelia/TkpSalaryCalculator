<?xml version="1.0" encoding="utf-8"?>
<ContentView
    x:Class="TkpSalaryCalculator.App.Presentation.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    x:DataType="local:EmptyStateView"
    x:Name="Root">
    <Border
        Padding="24"
        BackgroundColor="{StaticResource Surface}"
        SemanticProperties.Description="{Binding Message, Source={x:Reference Root}}"
        Stroke="{StaticResource Outline}"
        StrokeShape="RoundRectangle 16">
        <VerticalStackLayout Spacing="12">
            <Label
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding Title, Source={x:Reference Root}}" />
            <Label
                Style="{StaticResource SupportingTextStyle}"
                Text="{Binding Message, Source={x:Reference Root}}" />
            <Button
                Command="{Binding ActionCommand, Source={x:Reference Root}}"
                IsVisible="{Binding HasAction, Source={x:Reference Root}}"
                SemanticProperties.Description="{Binding ActionText, Source={x:Reference Root}}"
                Text="{Binding ActionText, Source={x:Reference Root}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
