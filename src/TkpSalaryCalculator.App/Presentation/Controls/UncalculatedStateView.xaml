<?xml version="1.0" encoding="utf-8"?>
<ContentView
    x:Class="TkpSalaryCalculator.App.Presentation.Controls.UncalculatedStateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    x:DataType="local:UncalculatedStateView"
    x:Name="Root">
    <Border
        Padding="20"
        BackgroundColor="{StaticResource WarningContainer}"
        SemanticProperties.Description="{Binding Reason, Source={x:Reference Root}}"
        SemanticProperties.Hint="{Binding NextAction, Source={x:Reference Root}}"
        Stroke="{StaticResource Warning}"
        StrokeShape="RoundRectangle 16">
        <VerticalStackLayout Spacing="8">
            <Label
                Style="{StaticResource SectionTitleStyle}"
                Text="未計算" />
            <Label Text="{Binding Reason, Source={x:Reference Root}}" />
            <Label
                Style="{StaticResource SupportingTextStyle}"
                Text="{Binding NextAction, Source={x:Reference Root}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
