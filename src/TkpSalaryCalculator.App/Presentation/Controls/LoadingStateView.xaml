<?xml version="1.0" encoding="utf-8"?>
<ContentView
    x:Class="TkpSalaryCalculator.App.Presentation.Controls.LoadingStateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    x:DataType="local:LoadingStateView"
    x:Name="Root">
    <VerticalStackLayout
        Padding="24"
        Spacing="12"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        SemanticProperties.Description="{Binding Message, Source={x:Reference Root}}">
        <ActivityIndicator
            IsRunning="{Binding IsRunning, Source={x:Reference Root}}"
            Color="{StaticResource Primary}"
            HorizontalOptions="Center" />
        <Label
            HorizontalTextAlignment="Center"
            Text="{Binding Message, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
