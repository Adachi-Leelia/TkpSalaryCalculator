<?xml version="1.0" encoding="utf-8"?>
<ContentView
    x:Class="TkpSalaryCalculator.App.Presentation.Controls.FixedSaveBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    x:DataType="local:FixedSaveBar"
    x:Name="Root"
    SafeAreaEdges="All">
    <Border
        Padding="16,12"
        BackgroundColor="{StaticResource Surface}"
        Stroke="{StaticResource Outline}"
        StrokeThickness="1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ActivityIndicator
                IsRunning="{Binding IsSaving, Source={x:Reference Root}}"
                IsVisible="{Binding IsSaving, Source={x:Reference Root}}"
                Color="{StaticResource Primary}"
                SemanticProperties.Description="保存中です"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Command="{Binding SaveCommand, Source={x:Reference Root}}"
                IsEnabled="{Binding IsNotSaving, Source={x:Reference Root}}"
                SemanticProperties.Description="入力内容を保存します"
                Text="{Binding SaveText, Source={x:Reference Root}}" />
        </Grid>
    </Border>
</ContentView>
