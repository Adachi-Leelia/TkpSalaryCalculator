<?xml version="1.0" encoding="utf-8"?>
<ContentView
    x:Class="TkpSalaryCalculator.App.Presentation.Controls.ErrorStateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    x:DataType="local:ErrorStateView"
    x:Name="Root">
    <Border
        Padding="24"
        BackgroundColor="{StaticResource ErrorContainer}"
        Stroke="{StaticResource Error}"
        StrokeShape="RoundRectangle 16"
        SemanticProperties.Description="{Binding Message, Source={x:Reference Root}}">
        <VerticalStackLayout Spacing="12">
            <Label
                Style="{StaticResource SectionTitleStyle}"
                Text="保存または読み込みに失敗しました" />
            <Label Text="{Binding Message, Source={x:Reference Root}}" />
            <Button
                Command="{Binding RetryCommand, Source={x:Reference Root}}"
                IsVisible="{Binding HasRetry, Source={x:Reference Root}}"
                SemanticProperties.Description="もう一度処理を試します"
                Text="{StaticResource Retry}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
