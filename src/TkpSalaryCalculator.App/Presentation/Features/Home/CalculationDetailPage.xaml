<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="TkpSalaryCalculator.App.Presentation.Features.Home.CalculationDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    xmlns:home="clr-namespace:TkpSalaryCalculator.App.Presentation.Features.Home"
    x:DataType="home:CalculationDetailViewModel"
    Title="計算内訳">
    <ContentPage.Resources>
        <DataTemplate x:Key="SectionHeaderTemplate" x:DataType="home:CalculationSectionHeaderRowViewModel">
            <Label Margin="20,18,20,4" Style="{StaticResource SectionTitleStyle}" Text="{Binding Title}" />
        </DataTemplate>
        <DataTemplate x:Key="PremiumTotalTemplate" x:DataType="home:CalculationPremiumTotalRowViewModel">
            <Grid Margin="20,4" ColumnDefinitions="*,Auto">
                <Label Text="{Binding DisplayName}" />
                <Label Grid.Column="1" Text="{Binding AmountText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AllowanceTemplate" x:DataType="home:CalculationAllowanceRowViewModel">
            <Grid Margin="20,4" ColumnDefinitions="*,Auto">
                <Label Text="{Binding DisplayName}" />
                <Label Grid.Column="1" Text="{Binding AmountText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DayTemplate" x:DataType="home:CalculationDayRowViewModel">
            <Border Margin="20,14,20,0" Padding="14" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="{Binding DateText}" />
                    <Grid IsVisible="{Binding HasDaySubtotal}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Text="基本給与小計" /><Label Grid.Column="1" Text="{Binding BasePayText}" />
                        <Label Grid.Row="1" Text="割増小計" /><Label Grid.Row="1" Grid.Column="1" Text="{Binding PremiumText}" />
                        <Label Grid.Row="2" Text="件数加算小計" /><Label Grid.Row="2" Grid.Column="1" Text="{Binding CountBonusText}" />
                        <Label Grid.Row="3" FontAttributes="Bold" Text="日別合計" /><Label Grid.Row="3" Grid.Column="1" FontAttributes="Bold" Text="{Binding TotalText}" />
                    </Grid>
                    <Label IsVisible="{Binding HasUncalculated}" Text="{Binding UncalculatedText}" TextColor="{StaticResource Warning}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="VisitTemplate" x:DataType="home:CalculationVisitRowViewModel">
            <Border Margin="20,14,20,0" Padding="14" BackgroundColor="{StaticResource PrimaryContainer}" SemanticProperties.Description="{Binding AccessibilityText}" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label FontAttributes="Bold" FontSize="18" Text="訪問" />
                        <Label Grid.Column="1" Style="{StaticResource SupportingTextStyle}" Text="{Binding TaskCountText}" />
                    </Grid>
                    <Label Text="{Binding DateText}" />
                    <Label FontAttributes="Bold" Text="{Binding TaskSummaryText}" />
                    <Label Style="{StaticResource SupportingTextStyle}" Text="{Binding StatusText}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="WorkRecordTemplate" x:DataType="home:CalculationWorkRecordRowViewModel">
            <Border Margin="32,10,20,0" Padding="12" BackgroundColor="{StaticResource PageBackground}" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="7">
                    <Label FontAttributes="Bold" SemanticProperties.Description="{Binding AccessibilityText}" Text="{Binding TaskTitle}" />
                    <Label FontAttributes="Bold" Text="{Binding DisplayName}" />
                    <Label Text="{Binding WorkTimeText}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <Label Text="適用基本単価" /><Label Grid.Column="1" Text="{Binding AppliedRateText}" />
                        <Label Grid.Row="1" Text="基本給与" /><Label Grid.Row="1" Grid.Column="1" Text="{Binding BasePayText}" />
                        <Label Grid.Row="2" FontAttributes="Bold" Text="タスク小計" /><Label Grid.Row="2" Grid.Column="1" FontAttributes="Bold" Text="{Binding TaskSubtotalText}" />
                    </Grid>
                    <Label IsVisible="{Binding HasMissingReason}" Text="{Binding MissingReasonText}" TextColor="{StaticResource Warning}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PremiumTemplate" x:DataType="home:CalculationPremiumRowViewModel">
            <Border Margin="44,6,20,0" Padding="10" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label FontAttributes="Bold" Text="{Binding DisplayName}" />
                    <Label Grid.Column="1" Text="{Binding AmountText}" />
                    <Label Grid.Row="1" Style="{StaticResource SupportingTextStyle}" Text="{Binding RuleText}" />
                    <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource SupportingTextStyle}" Text="{Binding ApplicableTimeText}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CountBonusTemplate" x:DataType="home:CalculationCountBonusRowViewModel">
            <Border Margin="32,10,20,0" Padding="10" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Grid.ColumnSpan="2" FontAttributes="Bold" Text="訪問の件数加算" />
                    <Label Grid.Row="1" Text="{Binding DisplayName}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding AmountText}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="WorkRecordTotalTemplate" x:DataType="home:CalculationWorkRecordTotalRowViewModel">
            <Border Margin="32,6,20,4" Padding="12" BackgroundColor="{StaticResource PageBackground}" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="7">
                    <Label IsVisible="{Binding HasMissingReason}" Text="{Binding MissingReasonText}" TextColor="{StaticResource Warning}" />
                    <Grid IsVisible="{Binding HasTotal}" ColumnDefinitions="*,Auto">
                        <Label FontAttributes="Bold" Text="訪問合計" />
                        <Label Grid.Column="1" FontAttributes="Bold" Text="{Binding TotalText}" />
                    </Grid>
                    <Label Style="{StaticResource SupportingTextStyle}" Text="{Binding SettingMonthText}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <home:CalculationDetailRowTemplateSelector
            x:Key="DetailRowTemplateSelector"
            AllowanceTemplate="{StaticResource AllowanceTemplate}"
            CountBonusTemplate="{StaticResource CountBonusTemplate}"
            DayTemplate="{StaticResource DayTemplate}"
            PremiumTemplate="{StaticResource PremiumTemplate}"
            PremiumTotalTemplate="{StaticResource PremiumTotalTemplate}"
            SectionHeaderTemplate="{StaticResource SectionHeaderTemplate}"
            VisitTemplate="{StaticResource VisitTemplate}"
            WorkRecordTemplate="{StaticResource WorkRecordTemplate}"
            WorkRecordTotalTemplate="{StaticResource WorkRecordTotalTemplate}" />
    </ContentPage.Resources>
    <Grid SafeAreaEdges="All">
        <CollectionView
            AutomationId="CalculationDetail.Rows"
            ItemTemplate="{StaticResource DetailRowTemplateSelector}"
            ItemsSource="{Binding Rows}"
            SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,20,20,0" Spacing="16">
                    <Label Style="{StaticResource PageTitleStyle}" Text="計算内訳" />
                    <Border Padding="16" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="6">
                            <Label FontAttributes="Bold" Text="給与期間" />
                            <Label Text="{Binding StartDateText}" />
                            <Label Text="{Binding EndDateText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border IsVisible="{Binding ShowsPayrollPeriodBreakdown}" Padding="16" BackgroundColor="{StaticResource PrimaryContainer}" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding TotalLabel}" />
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="24" SemanticProperties.Description="{Binding TotalText}" Text="{Binding TotalText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                <Label Text="基本給与" /><Label Grid.Column="1" Text="{Binding BasePayText}" />
                                <Label Grid.Row="1" Text="割増" /><Label Grid.Row="1" Grid.Column="1" Text="{Binding PremiumText}" />
                                <Label Grid.Row="2" Text="件数加算" /><Label Grid.Row="2" Grid.Column="1" Text="{Binding CountBonusText}" />
                                <Label Grid.Row="3" Text="月額手当" /><Label Grid.Row="3" Grid.Column="1" Text="{Binding AllowanceText}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <controls:UncalculatedStateView
                        IsVisible="{Binding HasPeriodUncalculated}"
                        NextAction="設定画面で不足しているサービス、時間区分、または単価を補ってください。"
                        Reason="{Binding UncalculatedText}" />
                    <controls:ErrorStateView IsVisible="{Binding HasError}" Message="{Binding ErrorMessage}" RetryCommand="{Binding ReloadCommand}" />
                    <controls:EmptyStateView IsVisible="{Binding IsEmpty}" Message="この給与期間には勤務記録がありません。" Title="計算内訳がありません" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="20" />
            </CollectionView.Footer>
        </CollectionView>
        <controls:LoadingStateView IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Message="計算内訳を読み込んでいます。" />
    </Grid>
</ContentPage>
