<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="TkpSalaryCalculator.App.Presentation.Features.Setup.InitialSetupFlowPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:setup="clr-namespace:TkpSalaryCalculator.App.Presentation.Features.Setup"
    x:DataType="setup:InitialSetupFlowViewModel"
    Title="初期設定"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="All">
        <Grid Padding="24,20,24,12" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Style="{StaticResource PageTitleStyle}" Text="{Binding StepTitle}" />
                <Label
                    Style="{StaticResource SupportingTextStyle}"
                    Text="初期設定" />
            </VerticalStackLayout>
            <Label
                Grid.Column="1"
                Style="{StaticResource SupportingTextStyle}"
                Text="{Binding ProgressText}"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView x:Name="SetupScrollView" Grid.Row="1">
            <VerticalStackLayout Padding="24,8,24,24" Spacing="16">
                <Border
                    AutomationId="Setup.ErrorSummary"
                    Padding="12"
                    BackgroundColor="{StaticResource PrimaryContainer}"
                    IsVisible="{Binding HasResumeMessage}"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 12">
                    <Label Text="{Binding ResumeMessage}" />
                </Border>

                <Border
                    Padding="12"
                    BackgroundColor="{StaticResource ErrorContainer}"
                    IsVisible="{Binding HasError}"
                    Stroke="{StaticResource Error}"
                    StrokeShape="RoundRectangle 12">
                    <Label
                        SemanticProperties.Description="初期設定のエラー"
                        Text="{Binding ErrorMessage}"
                        TextColor="{StaticResource Error}" />
                </Border>

                <setup:WelcomeStepView
                    BindingContext="{Binding Welcome}"
                    IsVisible="{Binding IsWelcomeStep}" />
                <setup:ClosingDayStepView
                    BindingContext="{Binding ClosingDay}"
                    IsVisible="{Binding IsClosingDayStep}" />
                <setup:ServiceRatesStepView
                    BindingContext="{Binding Services}"
                    IsVisible="{Binding IsServicesStep}" />
                <setup:AdditionsStepView
                    BindingContext="{Binding Additions}"
                    IsVisible="{Binding IsAdditionsStep}" />
                <setup:SetupConfirmationStepView
                    BindingContext="{Binding Confirmation}"
                    IsVisible="{Binding IsConfirmationStep}" />
            </VerticalStackLayout>
        </ScrollView>

        <Border
            Grid.Row="2"
            Padding="24,12"
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Outline}"
            StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Text="戻る" />
                <Button
                    Grid.Column="1"
                    Command="{Binding NextCommand}"
                    SemanticProperties.Description="{Binding PrimaryActionText}"
                    Text="{Binding PrimaryActionText}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
