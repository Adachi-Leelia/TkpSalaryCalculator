<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="TkpSalaryCalculator.App.Presentation.Features.Calendar.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    Title="カレンダー">
    <VerticalStackLayout Padding="20" SafeAreaEdges="All" Spacing="20">
        <Label Style="{StaticResource PageTitleStyle}" Text="カレンダー" />
        <controls:EmptyStateView
            Message="月間カレンダーと勤務入力は、実装ロードマップの勤務入力段階で追加されます。"
            Title="表示する勤務日がありません" />
    </VerticalStackLayout>
</ContentPage>
