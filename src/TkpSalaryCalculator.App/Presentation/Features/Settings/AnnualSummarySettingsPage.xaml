<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="TkpSalaryCalculator.App.Presentation.Features.Settings.AnnualSummarySettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    xmlns:settings="clr-namespace:TkpSalaryCalculator.App.Presentation.Features.Settings"
    x:DataType="settings:AnnualSummarySettingsViewModel"
    Title="年間累計設定">
    <Grid RowDefinitions="*,Auto" SafeAreaEdges="All">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="12">
                <Label Style="{StaticResource PageTitleStyle}" Text="年間累計設定" />
                <Label Text="年間締め月" />
                <Picker
                    ItemDisplayBinding="{Binding DisplayName}"
                    ItemsSource="{Binding ClosingMonths}"
                    SelectedItem="{Binding SelectedClosingMonth}" />
                <Border
                    Padding="12"
                    BackgroundColor="{StaticResource PrimaryContainer}"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 10">
                    <Label
                        SemanticProperties.Description="{Binding AnnualPeriodExample}"
                        Text="{Binding AnnualPeriodExample}" />
                </Border>
                <Label
                    Style="{StaticResource SupportingTextStyle}"
                    Text="この設定は年間累計の区切りだけを変更し、給与額や勤務記録は変更しません。" />
                <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" />
            </VerticalStackLayout>
        </ScrollView>
        <controls:FixedSaveBar
            Grid.Row="1"
            IsSaving="{Binding IsBusy}"
            SaveCommand="{Binding SaveCommand}"
            SaveText="保存" />
    </Grid>
</ContentPage>
