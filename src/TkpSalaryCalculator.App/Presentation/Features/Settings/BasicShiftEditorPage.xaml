<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="TkpSalaryCalculator.App.Presentation.Features.Settings.BasicShiftEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:settings="clr-namespace:TkpSalaryCalculator.App.Presentation.Features.Settings" xmlns:calendar="clr-namespace:TkpSalaryCalculator.App.Presentation.Features.Calendar"
    xmlns:controls="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    x:DataType="settings:BasicShiftEditorViewModel" Title="{Binding PageTitle}">
    <Grid RowDefinitions="*,Auto"><ScrollView><VerticalStackLayout Padding="20" SafeAreaEdges="All" Spacing="10">
        <Label Style="{StaticResource PageTitleStyle}" Text="{Binding PageTitle}" />
        <Label Text="曜日" /><Picker ItemsSource="{Binding Weekdays}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedWeekday}" />
        <Label Text="サービス" /><Picker ItemsSource="{Binding Services}" ItemDisplayBinding="{Binding PickerText}" SelectedItem="{Binding SelectedService}" />
        <Label Text="時間区分" /><Picker ItemsSource="{Binding TimeCategories}" ItemDisplayBinding="{Binding PickerText}" SelectedItem="{Binding SelectedTimeCategory}" />
        <Label Text="入力方式" /><Picker ItemsSource="{Binding InputModes}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedInputMode}" />
        <VerticalStackLayout IsVisible="{Binding ShowDuration}" Spacing="6"><Label Text="勤務時間（分）" /><Entry Keyboard="Numeric" Text="{Binding WorkMinutesText}" /><VerticalStackLayout IsVisible="{Binding ShowStartTime}" Spacing="6"><Label Text="開始時刻（時刻条件付き割増がある場合）" /><TimePicker Time="{Binding StartTime}" /></VerticalStackLayout></VerticalStackLayout>
        <Grid IsVisible="{Binding ShowTimeRange}" ColumnDefinitions="*,*" ColumnSpacing="10"><VerticalStackLayout><Label Text="開始時刻" /><TimePicker Time="{Binding StartTime}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="終了時刻" /><TimePicker Time="{Binding EndTime}" /></VerticalStackLayout></Grid>
        <Label Text="同じ曜日内の表示順" /><Entry Keyboard="Numeric" Text="{Binding DisplayOrderText}" />
        <HorizontalStackLayout Spacing="10"><Switch IsToggled="{Binding IsEnabled}" /><Label VerticalOptions="Center" Text="反映候補として使用する" /></HorizontalStackLayout>
        <Label Style="{StaticResource SupportingTextStyle}" Text="保存後にシフトを変更しても、すでに反映した勤務記録は変わりません。" /><Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" />
    </VerticalStackLayout></ScrollView>
    <controls:FixedSaveBar
        Grid.Row="1"
        SaveCommand="{Binding SaveCommand}"
        IsSaving="{Binding IsBusy}" />
    </Grid>
</ContentPage>
