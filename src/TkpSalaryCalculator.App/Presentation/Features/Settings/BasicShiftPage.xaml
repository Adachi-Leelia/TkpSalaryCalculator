<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="TkpSalaryCalculator.App.Presentation.Features.Settings.BasicShiftPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:settings="clr-namespace:TkpSalaryCalculator.App.Presentation.Features.Settings"
    xmlns:controls="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    x:DataType="settings:BasicShiftViewModel" Title="基本シフト">
    <ScrollView><VerticalStackLayout Padding="20" SafeAreaEdges="All" Spacing="12">
        <Label Style="{StaticResource PageTitleStyle}" Text="基本シフト" /><Label Style="{StaticResource SupportingTextStyle}" Text="曜日ごとの入力テンプレートです。確認して反映するまで勤務実績や給与には含まれません。" />
        <controls:EmptyStateView IsVisible="{Binding HasNoRows}" Title="基本シフトはありません" Message="よくある勤務を曜日ごとに登録できます。" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="14"><BindableLayout.ItemTemplate><DataTemplate x:DataType="settings:BasicShiftGroup"><VerticalStackLayout Spacing="8"><Label Style="{StaticResource SectionTitleStyle}" Text="{Binding WeekdayText}" /><Label IsVisible="{Binding HasNoRows}" Style="{StaticResource SupportingTextStyle}" Text="登録なし" /><VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate x:DataType="settings:BasicShiftRow"><Border Padding="12" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 10"><VerticalStackLayout Spacing="4"><Label FontAttributes="Bold" Text="{Binding WorkText}" /><Label Text="{Binding TimeText}" /><Label Style="{StaticResource SupportingTextStyle}" Text="{Binding OrderText}" /><Label Style="{StaticResource SupportingTextStyle}" Text="{Binding StatusText}" /><Label IsVisible="{Binding HasWarning}" Text="{Binding WarningText}" TextColor="{StaticResource Warning}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="編集" /><Button Grid.Column="1" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="削除" /></Grid></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
        <Button Command="{Binding AddCommand}" Text="基本シフトを追加" /><Label IsVisible="{Binding HasSuccessMessage}" Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" /><Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
