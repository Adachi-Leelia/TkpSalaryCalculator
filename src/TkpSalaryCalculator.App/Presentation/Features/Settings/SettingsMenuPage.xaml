    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    Title="設定">
    <VerticalStackLayout Padding="20" SafeAreaEdges="All" Spacing="20">
        <Label Style="{StaticResource PageTitleStyle}" Text="設定" />
