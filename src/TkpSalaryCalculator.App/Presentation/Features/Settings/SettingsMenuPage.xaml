<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="TkpSalaryCalculator.App.Presentation.Features.Settings.SettingsMenuPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:settings="clr-namespace:TkpSalaryCalculator.App.Presentation.Features.Settings"
    x:DataType="settings:SettingsMenuViewModel"
    Title="設定">
    <ScrollView>
        <VerticalStackLayout Padding="20" SafeAreaEdges="All" Spacing="14">
            <Label Style="{StaticResource PageTitleStyle}" Text="設定" />
            <Border Padding="14" BackgroundColor="{StaticResource PrimaryContainer}" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource SectionTitleStyle}" Text="給与設定" />
                    <Label FontAttributes="Bold" Text="{Binding MonthHeaderText}" />
                    <Label Style="{StaticResource SupportingTextStyle}" Text="この年月だけの単価・割増・件数加算を編集します。入力補助とデータ管理には適用されません。" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Command="{Binding PreviousMonthCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="前の月" />
                        <Button Grid.Column="1" Command="{Binding NextMonthCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="次の月" />
                    </Grid>
                    <Button Command="{Binding CopyPreviousMonthCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="前月の設定をコピー" />
                </VerticalStackLayout>
            </Border>
            <Label IsVisible="{Binding HasSuccessMessage}" Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" />
            <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" />
            <Button Command="{Binding OpenServicesCommand}" Text="サービス・単価" />
            <Button Command="{Binding OpenPremiumsCommand}" Text="割増" />
            <Button Command="{Binding OpenCountBonusesCommand}" Text="件数加算" />
            <Button Command="{Binding OpenMonthlyAllowancesCommand}" Text="月額手当" />
            <Button Command="{Binding OpenPayrollPeriodCommand}" Text="給与期間" />
            <Button Command="{Binding OpenAnnualSummarySettingsCommand}" Text="年間累計" />
            <Label Style="{StaticResource SectionTitleStyle}" Text="入力補助" />
            <Label Style="{StaticResource SupportingTextStyle}" Text="よく使うサービス設定（全期間共通）は、サービス・単価画面で給与設定と区別して管理できます。" />
            <Button Command="{Binding OpenBasicShiftsCommand}" Text="基本シフト" />
            <Label Style="{StaticResource SectionTitleStyle}" Text="データ・アプリ" />
            <Button Command="{Binding OpenDataManagementCommand}" Text="データ管理" />
            <Button Command="{Binding OpenAppInformationCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="アプリ情報" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
