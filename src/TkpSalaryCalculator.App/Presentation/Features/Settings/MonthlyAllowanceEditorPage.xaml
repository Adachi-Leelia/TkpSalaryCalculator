<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="TkpSalaryCalculator.App.Presentation.Features.Settings.MonthlyAllowanceEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:settings="clr-namespace:TkpSalaryCalculator.App.Presentation.Features.Settings"
    xmlns:controls="clr-namespace:TkpSalaryCalculator.App.Presentation.Controls"
    x:DataType="settings:MonthlyAllowanceEditorViewModel" Title="{Binding PageTitle}">
    <Grid RowDefinitions="*,Auto"><ScrollView><VerticalStackLayout Padding="20" SafeAreaEdges="All" Spacing="12">
        <Label Style="{StaticResource PageTitleStyle}" Text="{Binding PageTitle}" /><Label FontAttributes="Bold" Text="{Binding PeriodText}" />
        <Label Text="表示名" /><Entry Text="{Binding DisplayName}" Placeholder="例: 資格手当" />
        <Label Text="金額（円）" /><Entry Keyboard="Numeric" Text="{Binding AmountText}" />
        <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" />
    </VerticalStackLayout></ScrollView>
    <controls:FixedSaveBar
        Grid.Row="1"
        SaveCommand="{Binding SaveCommand}"
        IsSaving="{Binding IsBusy}" />
    </Grid>
</ContentPage>
