<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TkpSalaryCalculator.App.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:TkpSalaryCalculator.App.Presentation.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Strings/Strings.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:YenAmountConverter x:Key="YenAmountConverter" />
            <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
            <converters:MinuteOfDayConverter x:Key="MinuteOfDayConverter" />
            <converters:WorkMinutesConverter x:Key="WorkMinutesConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
